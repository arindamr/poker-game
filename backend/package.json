{
  "name": "poker-app-backend",
  "version": "1.0.0",
  "description": "Node.js backend for multiplayer poker app",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "migrate": "node migrations/migrate.js",
    "migrate:rollback": "node migrations/rollback.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "seed": "node migrations/seed.js"
  },
  "keywords": [
    "poker",
    "multiplayer",
    "websocket",
    "game",
    "backend"
  ],
  "author": "Poker App Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.3.5",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "joi": "^17.9.1",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.9.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.3",
    "rate-limit-redis": "^3.0.1",
    "socket.io": "^4.5.4",
    "speakeasy": "^2.0.0",
    "uuid": "^9.0.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "eslint": "^8.40.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.5",
    "jest": "^29.5.0",
    "nodemon": "^2.0.20",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

# Backend-specific environment variables
NODE_ENV=development
PORT=3000
WEBSOCKET_PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=poker_game
DB_USER=postgres
DB_PASSWORD=postgres_password
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/poker_game

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_dev_jwt_secret_key
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your_dev_refresh_secret
JWT_REFRESH_EXPIRATION=7d

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Game Configuration
SMALL_BLIND=0.5
BIG_BLIND=1.0
MIN_BUY_IN=10
MAX_BUY_IN=1000
HAND_TIMEOUT=30

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# CORS
CORS_ORIGIN=http://localhost:5000,http://localhost:3000

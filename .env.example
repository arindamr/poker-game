# Environment Configuration Template
# Copy this to .env and update values for your environment

# Node.js Backend
NODE_ENV=development
PORT=3000
BACKEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=poker_game
DB_USER=postgres
DB_PASSWORD=postgres_password
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/poker_game

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRATION=7d

# WebSocket
WEBSOCKET_PORT=3001
WEBSOCKET_CORS_ORIGIN=http://localhost:5000

# Game Configuration
SMALL_BLIND=0.5
BIG_BLIND=1.0
MIN_BUY_IN=10
MAX_BUY_IN=1000
TABLE_MAX_SEATS=6
HAND_TIMEOUT=30

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ENABLE_RATE_LIMITING=true

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Payment Integration (Stripe/PayPal - optional)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# CORS
CORS_ORIGIN=http://localhost:5000,http://localhost:3000

# Admin Configuration
ADMIN_EMAIL=admin@pokerapp.local
ADMIN_PASSWORD=change_me_in_production
